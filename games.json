  "verses": {
    "title_ta": "குறள்கள்",
    "title_en": "The verses",
    "_note": "Tamil text verbatim. 'split' = combined words separated (as used in the crossword). 'phonetic' = English pronunciation. 'urai' = Kalaignar Mu. Karunanidhi's explanation (one line per list item). 'english' = G.U. Pope's translation (1886).",
    "items": [
      {
        "source": "(குறள் எண்: 48, அதிகாரம்: இல்வாழ்க்கை, அறத்துப்பால்)",
        "ta": [
          "ஆற்றின் ஒழுக்கி அறனிழுக்கா இல்வாழ்க்கை",
          "நோற்பாரின் நோன்மை உடைத்து."
        ],
        "split": "ஆற்றின் · ஒழுக்கி · அறன் · இழுக்கா · இல்வாழ்க்கை · நோற்பாரின் · நோன்மை · உடைத்து",
        "phonetic": [
          "Aatrin Ozhukki Aranizhukkaa Ilvaazhkkai",
          "Noarpaarin Noanmai Udaiththu"
        ],
        "urai": [
          "தானும் அறவழியில் நடந்து, பிறரையும் அவ்வழியில் நடக்கச் செய்திடுவோரின் இல்வாழ்க்கை,",
          "துறவிகள் கடைப்பிடிக்கும் நோன்பைவிடப் பெருமையுடையதாகும்."
        ],
        "english": [
          "Others it sets upon their way, itself from virtue ne'er declines;",
          "Than stern ascetics' pains such life domestic brighter shines."
        ]
      },
      {
        "source": "(குறள் எண்: 93, அதிகாரம்: இனியவை கூறல், அறத்துப்பால்)",
        "ta": [
          "முகத்தான் அமர்ந்து இனிதுநோக்கி அகத்தானாம்",
          "இன்சொ லினதே அறம்."
        ],
        "split": "முகத்தான் · அமர்ந்து · இனிது · நோக்கி · அகத்தான் · ஆம் · இன்சொல் · இனதே · அறம்",
        "phonetic": [
          "Mugaththaan Amarndhu Inidhu Noakki Agaththaanaam",
          "Insolinadhae Aram"
        ],
        "urai": [
          "முகம் மலர நோக்கி, அகம் மலர இனிய சொற்களைக் கூறுவதே",
          "அறவழியில் அமைந்த பண்பாகும்."
        ],
        "english": [
          "With brightly beaming smile, and kindly light of loving eye,",
          "And heart sincere, to utter pleasant words is charity."
        ]
      }
