      {
        "source": "(குறள் எண்: 306, அதிகாரம்: வெகுளாமை, அறத்துப்பால்)",
        "ta": [
          "சினமென்னும் சேர்ந்தாரைக் கொல்லி இனமென்னும்",
          "ஏமப் புணையைச் சுடும்"
        ],
        "split": "சினம் · என்னும் · சேர்ந்தாரை · கொல்லி · இனம் · என்னும் · ஏம · புணையை · சுடும்",
        "phonetic": [
          "Sinamennum Saerndhaaraik Kolli Inamennum",
          "Aemap Punaiyaich Chudum"
        ],
        "urai": [
          "சினங்கொண்டவரை அழிக்கக் கூடியதாகச் சினமென்னும் தீயே இருப்பதால், அது அவரை மட்டுமின்றி,",
          "அவரைப் பாதுகாக்கும் தோணி போன்ற சுற்றத்தையும் அழித்துவிடும்."
        ],
        "english": [
          "Wrath, the fire that slayeth whose draweth near,",
          "Will burn the helpful 'raft' of kindred dear."
        ]
      },
      {
        "source": "(அதிகாரம்: புணர்ச்சி மகிழ்தல், குறள் எண்: 1107)",
        "ta": [
          "தம்மில் இருந்து தமதுபாத்து உண்டற்றால்",
          "அம்மா அரிவை முயக்கு"
        ],
        "split": "தம் · இல் · இருந்து · தமது · பாத்து · உண்டற்று · ஆல் · அம் · மா · அரிவை · முயக்கு",
        "phonetic": [
          "Thammil Irundhu Thamadhupaaththu Undatraal",
          "Ammaa Arivai Muyakku"
        ],
        "urai": [
          "தானே உழைத்துச் சேர்த்ததைப் பலருக்கும் பகுத்து வழங்கி உண்டு களிப்பதில் ஏற்படும் இன்பம்,",
          "தனது அழகிய காதல் மனைவியைத் தழுவுகின்ற இன்பத்துக்கு ஒப்பானது."
        ],
        "english": [
          "As when one eats from household store, with kindly grace",
          "Sharing his meal: such is this golden maid's embrace."
        ]
      }
